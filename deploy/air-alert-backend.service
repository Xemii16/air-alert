[Unit]
Description=Air Alert Spring Boot Webhook Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airalert
Group=airalert
WorkingDirectory=/opt/air-alert
EnvironmentFile=/etc/air-alert/backend.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -jar /opt/air-alert/air-alert-backend.jar
SuccessExitStatus=143
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=air-alert-backend

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/air-alert

[Install]
WantedBy=multi-user.target
